{
  "name": "javascript-client-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"npm:dev --workspace=client\" \"npm:dev --workspace=server\"",
    "build": "npm run build --workspace=client",
    "start:server": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}